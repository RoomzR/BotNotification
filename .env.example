# === Telegram ===
# 1. Напиши @BotFather в Telegram → /newbot → скопируй токен
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Напиши боту любое сообщение, затем открой:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    и скопируй "chat":{"id": ЧИСЛО }
TELEGRAM_CHAT_ID=123456789

# === Камера Hikvision (предпочтительно) ===
# В iVMS-4200: Управление устройством → найди Reception 01_REG → IP
# Логин/пароль — те же, что для камеры в iVMS
CAMERA_USER=admin
CAMERA_PASSWORD=your_camera_password
CAMERA_IP=192.168.1.64
# Канал: 101 = основной поток, 102 = субпоток (легче для ПК)
CAMERA_CHANNEL=102

# Или укажи полный RTSP URL вручную (тогда IP/USER/PASSWORD выше не нужны):
# RTSP_URL=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/102

# === Режим источника ===
# rtsp  — поток с камеры (рекомендуется)
# screen — захват окна iVMS-4200 (если RTSP недоступен)
SOURCE_MODE=rtsp

# Имя окна iVMS (часть заголовка), только для SOURCE_MODE=screen
IVMS_WINDOW_TITLE=iVMS-4200

# === Langame (опционально, для run_platform) ===
# LANGAME_API_TOKEN=
# LANGAME_PC_AGENT_URL=http://127.0.0.1:8787
